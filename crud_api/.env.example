# Copier ce fichier en .env puis adapter.

# Base PostgreSQL (pilote asyncpg obligatoire)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/parc
DB_SCHEMA=eparc
DB_ECHO=false

# Serveur de developpement (commande `uv run crud-api`)
HOST=127.0.0.1
PORT=8000
RELOAD=true

# Origines autorisees pour le frontend, separees par des virgules
CORS_ORIGINS=http://localhost:5173

# Authentification : false = API ouverte (l'UI n'a pas encore d'ecran de connexion)
AUTH_ENABLED=false
# Obligatoire si AUTH_ENABLED=true : au moins 32 caracteres (ex. `python -c "import secrets; print(secrets.token_urlsafe(48))"`)
JWT_SECRET=
ACCESS_TOKEN_MINUTES=480

# Si renseigne et qu'aucun utilisateur n'existe, cree le compte `admin` au demarrage
BOOTSTRAP_ADMIN_PASSWORD=

# Dossier des fichiers envoyes (images du materiel)
UPLOAD_DIR=uploads
# Nom de la structure imprime sur les fiches de detention
STRUCTURE_NAME=

# Tableau de bord : objectifs (les valeurs ci-dessous sont les valeurs par defaut)
# OBJECTIF_ATTRIBUTION_MIN=75
# OBJECTIF_ATTRIBUTION_MAX=85
# OBJECTIF_STOCK_MIN=50
# OBJECTIF_MAINTENANCE_MAX=15
# OBJECTIF_AGE_MOYEN_MAX=3.5
# OBJECTIF_ANCIENS_MAX=40
# AGE_ANCIEN_ANS=5
# STOCK_CATEGORIE_ALERTE_PCT=10
# STOCK_CATEGORIE_CIBLE_PCT=15
# LICENCE_ALERTE_JOURS=60
# DOSSIER_RETARD_JOURS=30
